{
  "name": "pernosco-mcp",
  "version": "0.2.3",
  "description": "MCP server for Pernosco debugging sessions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnjaeschke/pernosco-mcp.git"
  },
  "bin": {
    "pernosco-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/version.js && tsc",
    "build:extension": "cd extension && zip -r ../pernosco-mcp.xpi manifest.json background.js inject.js",
    "build:all": "npm run build && npm run build:extension",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "dev": "node scripts/version.js && tsc --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.5.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
