{
  "manifest_version": 2,
  "name": "pernosco-mcp",
  "version": "0.1.0",
  "description": "Bridges Claude Code to Pernosco debugging sessions via pernosco-mcp daemon",
  "permissions": [
    "tabs",
    "cookies",
    "nativeMessaging",
    "https://pernos.co/*"
  ],
  "content_scripts": [{
    "matches": ["https://pernos.co/debug/*"],
    "js": ["inject.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "scripts": ["background.js"]
  },
  "applications": {
    "gecko": {
      "id": "pernosco-mcp@pernosco-mcp"
    }
  }
}
