{
  "manifest_version": 2,
  "name": "pernosco-mcp",
  "version": "0.2.1",
  "description": "Bridges Claude Code to Pernosco debugging sessions via pernosco-mcp daemon",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "https://pernos.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pernos.co/debug/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pernosco-mcp@pernosco-mcp",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
